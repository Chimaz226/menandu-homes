<!-- Hand-drawn vector of the Menandu Homes house mark, in the original PNG's 829×457 coordinate space. -->
<g id="ground">
  <!-- lawn with two posts -->
  <path fill="#8DC63F" d="M292 190 C 305 180, 335 173, 364 171 L 364 160 Q 364 158 366 158 L 382 158 Q 384 158 384 160 L 384 170 C 410 169, 440 168, 464 168 L 464 152 Q 464 150 466 150 L 482 150 Q 484 150 484 152 L 484 170 C 515 172, 540 178, 560 188 C 520 186, 470 184, 420 184 C 370 184, 325 186, 292 190 Z"/>
  <!-- ground swoosh -->
  <path fill="#8DC63F" d="M220 226 C 290 196, 350 186, 410 186 C 470 186, 530 196, 600 226 C 530 205, 470 198, 410 198 C 350 198, 290 205, 220 226 Z"/>
  <!-- navy arc under the ground -->
  <path fill="#10578D" d="M283 222 C 330 208, 370 204, 405 204 C 440 204, 480 208, 520 219 C 480 212, 440 210, 405 210 C 370 210, 330 213, 283 222 Z"/>
</g>
<g id="palms" fill="#8DC63F">
  <g id="palm">
    <!-- trunk -->
    <path d="M246 224 C 245 190, 240 158, 227 128 L 233 126 C 246 156, 253 190, 254 224 Z"/>
    <!-- fronds radiating from the crown at (229,124): broad leaves for a full crown -->
    <path d="M229 125 C 220 109, 204 101, 187 106 C 196 109, 203 113, 207 118 C 214 117, 222 119, 229 125 Z"/>
    <path d="M229 125 C 212 119, 196 125, 188 141 C 196 137, 203 135, 209 136 C 214 130, 221 127, 229 125 Z"/>
    <path d="M229 125 C 221 113, 218 98, 225 86 C 227 95, 231 100, 235 103 C 232 110, 230 117, 229 125 Z"/>
    <path d="M229 125 C 240 108, 256 101, 271 105 C 262 108, 256 112, 252 117 C 244 117, 236 120, 229 125 Z"/>
    <path d="M229 125 C 246 119, 262 125, 270 141 C 262 137, 255 135, 249 136 C 244 130, 237 127, 229 125 Z"/>
    <path d="M229 125 C 219 131, 211 141, 208 154 C 214 148, 219 145, 223 144 C 224 137, 226 131, 229 125 Z"/>
    <path d="M229 125 C 239 131, 247 141, 250 154 C 244 148, 239 145, 235 144 C 234 137, 232 131, 229 125 Z"/>
  </g>
  <use href="#palm" transform="translate(819 0) scale(-1 1)"/>
</g>
<g id="house">
  <!-- roof blade with the notch on the left -->
  <path fill="#2580BD" d="M480 9 C 455 45, 425 85, 398 118 C 385 135, 375 146, 362 150 C 330 160, 295 168, 262 176 C 275 160, 292 146, 308 139 C 325 133, 345 130, 360 128 C 366 127, 367 116, 361 114 C 352 112, 343 112, 338 108 C 331 100, 325 88, 318 73 C 360 58, 420 36, 480 9 Z"/>
