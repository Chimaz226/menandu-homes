  <!-- right rafter -->
  <path fill="#10578D" d="M486 37 C 488 33, 494 33, 496 37 L 563 168 C 565 172, 562 176, 558 176 C 556 176, 554 175, 553 173 L 486 41 Z"/>
  <!-- window: 2×2 panes -->
  <g fill="#10578D">
    <rect x="456" y="89" width="15" height="14" rx="2.5"/>
    <rect x="477" y="89" width="15" height="14" rx="2.5"/>
    <rect x="456" y="107" width="15" height="14" rx="2.5"/>
    <rect x="477" y="107" width="15" height="14" rx="2.5"/>
  </g>
</g>
